# Copy this file to .env and fill in real values. NEVER commit .env
ENVIRONMENT=development                      # development | production
SECRET_KEY=replace-with-long-random-string   # python -c "import secrets; print(secrets.token_hex(32))"

# Real database (PostgreSQL). Start it with:  docker compose up -d db
DATABASE_URL=postgresql+psycopg://gridweave:gridweave_dev@localhost:5432/gridweave
# Hosted Postgres (Neon / Supabase / Render) also works - paste their connection string here.

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
AUTO_CREATE_TABLES=false                     # keep false: tables come from Alembic migrations
TAX_PERCENT=0
LOG_LEVEL=INFO

# --- Payments ---------------------------------------------------------------
PAYMENT_MODE=test              # test = built-in simulator | razorpay = real Razorpay gateway
# Fill these when PAYMENT_MODE=razorpay (Razorpay Dashboard -> Settings -> API Keys / Webhooks).
# Use the rzp_test_ keys while developing - no real money moves.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_TERMS_DAYS=15          # invoice due date = issue date + this many days
